@model List<TechShop.Models.CartItem>

@{
    ViewData["Title"] = "Mon Panier";
    Layout = "_StoreLayout";
}

<div class="row mt-4">
    <div class="col-12 mb-4 text-center">
        <h1 style="font-weight: 700; color: var(--text-main);">Mon Panier</h1>
    </div>
</div>

<div class="row">
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5 bg-white shadow-sm rounded-4">
            <i class="bi bi-cart-x text-muted" style="font-size: 5rem;"></i>
            <h3 class="mt-4 text-muted">Votre panier est vide</h3>
            <p class="mb-4">Découvrez nos produits et trouvez votre bonheur.</p>
            <a asp-controller="Store" asp-action="Index" class="btn btn-primary px-4 py-2" style="font-weight: 600;">Retour à la boutique</a>
        </div>
    }
    else
    {
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-4">Produit</th>
                                    <th scope="col">Prix unitaire</th>
                                    <th scope="col" style="width: 150px;">Quantité</th>
                                    <th scope="col">Total</th>
                                    <th scope="col" class="pe-4 text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                @if (!string.IsNullOrEmpty(item.Image))
                                                {
                                                    <img src="@item.Image" alt="@item.Nom" style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px; margin-right: 15px;" />
                                                }
                                                else
                                                {
                                                    <div style="width: 60px; height: 60px; background: #f8fafc; border-radius: 8px; margin-right: 15px; display: flex; align-items: center; justify-content: center;">
                                                        <i class="bi bi-image text-muted fs-4"></i>
                                                    </div>
                                                }
                                                <div>
                                                    <h6 class="mb-0 fw-bold">@item.Nom</h6>
                                                    <small class="text-muted">Réf: @item.Reference</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@item.Prix.ToString("N2") DT</td>
                                        <td>
                                            <form asp-action="Update" method="post" class="d-flex">
                                                <input type="hidden" name="produitId" value="@item.ProduitID" />
                                                <input type="number" name="quantite" class="form-control form-control-sm text-center me-2" value="@item.Quantite" min="1" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-clockwise"></i></button>
                                            </form>
                                        </td>
                                        <td class="fw-bold">@item.SousTotal.ToString("N2") DT</td>
                                        <td class="pe-4 text-end">
                                            <form asp-action="Remove" method="post">
                                                <input type="hidden" name="produitId" value="@item.ProduitID" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash3"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-4">Récapitulatif</h4>
                    
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Nombre d'articles :</span>
                        <span class="fw-bold">@Model.Sum(x => x.Quantite)</span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between mb-4">
                        <span class="fw-bold fs-5">Total HT :</span>
                        <span class="fw-bold fs-4 text-primary">@Model.Sum(x => x.SousTotal).ToString("N2") DT</span>
                    </div>

                    @if (User.Identity.IsAuthenticated)
                    {
                        <form asp-action="Checkout" method="post">
                            <button type="submit" class="btn btn-success w-100 py-3 fw-bold fs-5 rounded-3">
                                <i class="bi bi-check2-circle me-2"></i> Valider la commande
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-4 text-center">
                            Vous devez être connecté pour passer la commande.
                        </div>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100 py-3 fw-bold rounded-3">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Se connecter
                        </a>
                        <div class="text-center mt-3">
                            <a asp-controller="Account" asp-action="Register" class="text-decoration-none">Ou créer un compte</a>
                        </div>
                    }

                    <div class="mt-4 text-center">
                        <a asp-controller="Store" asp-action="Index" class="text-decoration-none text-muted">
                            <i class="bi bi-arrow-left me-1"></i> Continuer mes achats
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
