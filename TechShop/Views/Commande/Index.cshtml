@model IEnumerable<TechShop.Models.Vente>

@{
    ViewData["Title"] = "Gestion des Commandes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold m-0"><i class="bi bi-cart-check me-2"></i> Commandes en Ligne</h2>
</div>

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-4">
        <form method="get" asp-action="Index" class="mb-4">
            <div class="d-flex gap-2 align-items-end">
                <div style="width: 200px;">
                    <label class="form-label small fw-bold">État Livraison</label>
                    <select name="statut" class="form-select" onchange="this.form.submit()">
                        <option value="">— Tous —</option>
                        @foreach (var s in Enum.GetValues(typeof(TechShop.Models.VenteStatut)).Cast<TechShop.Models.VenteStatut>())
                        {
                            <option value="@s" selected="@(ViewBag.Statut == s)">@s</option>
                        }
                    </select>
                </div>
                <div style="width: 200px;">
                    <label class="form-label small fw-bold">Facturation</label>
                    <select name="isFacturee" class="form-select" onchange="this.form.submit()">
                        <option value="">— Toutes —</option>
                        <option value="true" selected="@(ViewBag.IsFacturee == true)">Facturées</option>
                        <option value="false" selected="@(ViewBag.IsFacturee == false)">Non facturées</option>
                    </select>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary">Réinitialiser</a>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>N° Commande</th>
                        <th>Date</th>
                        <th>Client</th>
                        <th>Montant</th>
                        <th>Facturation</th>
                        <th>État Livraison</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Aucune commande trouvée.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">#@item.VenteID</td>
                                <td>@item.DateVente.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <div>@item.Utilisateur?.Nom</div>
                                    <small class="text-muted">@item.Utilisateur?.Email</small>
                                </td>
                                <td class="fw-bold text-primary">@item.MontantHT.ToString("N2") DT</td>
                                <td>
                                    @if (item.Facture != null)
                                    {
                                        <span class="badge bg-success">🟢 Facturée</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">🟡 Non facturée</span>
                                    }
                                </td>
                                <td>
                                    @{
                                        string badgeClass = item.Statut switch
                                        {
                                            TechShop.Models.VenteStatut.EnAttente => "bg-warning text-dark",
                                            TechShop.Models.VenteStatut.Validee => "bg-info text-white",
                                            TechShop.Models.VenteStatut.EnExpedition => "bg-primary",
                                            TechShop.Models.VenteStatut.Livree => "bg-success",
                                            TechShop.Models.VenteStatut.Annulee => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass px-3 py-2">@item.Statut</span>
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@item.VenteID" class="btn btn-sm btn-primary">
                                        Gérer
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
