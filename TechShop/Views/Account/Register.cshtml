@model TechShop.Models.Utilisateur

@{
    ViewData["Title"] = "Inscription";
    Layout = "_StoreLayout";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm border-0" style="border-radius: 12px; margin-top: 2rem;">
            <div class="card-body p-5">
                <h2 class="text-center mb-4" style="font-weight: 700;">Inscription</h2>
                
                <form method="post" asp-action="RegisterPost">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="mb-3">
                        <label asp-for="Nom" class="form-label" style="font-weight: 500;">Nom complet</label>
                        <input asp-for="Nom" class="form-control" required placeholder="Jean Dupont" />
                        <span asp-validation-for="Nom" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label" style="font-weight: 500;">Email</label>
                        <input asp-for="Email" class="form-control" required placeholder="votre@email.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Telephone" class="form-label" style="font-weight: 500;">Téléphone</label>
                        <input asp-for="Telephone" class="form-control" placeholder="216 XX XX XX XX" />
                        <span asp-validation-for="Telephone" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Adresse" class="form-label" style="font-weight: 500;">Adresse</label>
                        <input asp-for="Adresse" class="form-control" placeholder="123 Rue de la Liberté, Tunis" />
                        <span asp-validation-for="Adresse" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label" style="font-weight: 500;">Mot de passe</label>
                        <input type="password" name="clearPassword" class="form-control" required placeholder="••••••••" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100" style="padding: 0.75rem; font-weight: 600;">Créer un compte</button>
                </form>

                <div class="text-center mt-4">
                    <p class="text-muted">Déjà un compte ? <a asp-action="Login" class="text-decoration-none">Se connecter</a></p>
                </div>
            </div>
        </div>
    </div>
</div>
