@model TechShop.Models.Utilisateur

@{
    ViewData["Title"] = "Connexion";
    Layout = "_StoreLayout";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm border-0" style="border-radius: 12px; margin-top: 2rem;">
            <div class="card-body p-5">
                <h2 class="text-center mb-4" style="font-weight: 700;">Connexion</h2>
                
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <form method="post" asp-action="Login">
                    <div class="mb-3">
                        <label class="form-label" style="font-weight: 500;">Email</label>
                        <input type="email" name="email" class="form-control" required placeholder="votre@email.com" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label" style="font-weight: 500;">Mot de passe</label>
                        <input type="password" name="password" class="form-control" required placeholder="••••••••" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100" style="padding: 0.75rem; font-weight: 600;">Se connecter</button>
                </form>

                <div class="text-center mt-4">
                    <p class="text-muted">Pas encore de compte ? <a asp-action="Register" class="text-decoration-none">S'inscrire</a></p>
                </div>
            </div>
        </div>
    </div>
</div>
