@model IEnumerable<TechShop.Models.Produit>

@{
    ViewData["Title"] = "Rapport d'inventaire";
    bool alertOnly = ViewBag.AlertOnly ?? false;
}

<div class="d-flex align-items-center mb-4">
    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Retour</a>

    <h2 class="fw-bold m-0">Rapport d'inventaire</h2>
</div>

<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-body p-4">
        
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div>
                <h5 class="fw-bold mb-1">Stock critique</h5>
                <p class="text-muted small mb-0">Produits nécessitant un réapprovisionnement (Stock < 5)</p>
            </div>
            <div class="btn-group">
                <a asp-action="Stock" asp-route-alertOnly="true" class="btn @(alertOnly ? "btn-danger" : "btn-outline-danger")">
                    Alertes uniquement
                </a>
                <a asp-action="Stock" asp-route-alertOnly="false" class="btn @(!alertOnly ? "btn-secondary" : "btn-outline-secondary")">
                    Tout le catalogue
                </a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Produit</th>
                        <th>Catégorie</th>
                        <th>Marque</th>
                        <th class="text-center">Quantité</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <i class="ti ti-check-circle text-success display-4 d-block mb-3"></i>
                                <p class="text-muted mb-0">Aucune alerte de stock en cours.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            var statusClass = item.Quantite == 0 ? "bg-danger" : (item.Quantite < 5 ? "bg-warning text-dark" : "bg-success");
                            var statusText = item.Quantite == 0 ? "Rupture" : (item.Quantite < 5 ? "Stock bas" : "Correct");

                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(item.Image))
                                        {
                                            <img src="@item.Image" class="rounded-3 me-3" style="width: 45px; height: 45px; object-fit: cover;" />
                                        }
                                        <div>
                                            <div class="fw-bold">@item.Nom</div>
                                            <small class="text-muted">Ref: @item.Reference</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@item.Categorie?.Name</td>
                                <td>@item.Marque?.Name</td>
                                <td class="text-center">
                                    <span class="fs-5 fw-bold">@item.Quantite</span>
                                </td>
                                <td>
                                    <span class="badge @statusClass">@statusText</span>
                                </td>
                                
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
