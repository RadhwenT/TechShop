@model TechShop.Models.Produit

@{
    ViewData["Title"] = "Modifier Produit";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="d-flex align-items-center gap-3 mb-4">
            <h2 class="mb-0">Modifier : @Model.Nom</h2>
            <a asp-action="Index" class="btn btn-secondary">Retour</a>

        </div>

        <div class="card p-4">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ProduitID" />
                <input type="hidden" asp-for="Quantite" />
                <input type="hidden" id="removeImageInput" name="removeImage" value="false" />

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="Reference" class="form-label">Référence *</label>
                        <input asp-for="Reference" class="form-control" />
                        <span asp-validation-for="Reference" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Nom" class="form-label">Nom *</label>
                        <input asp-for="Nom" class="form-control" />
                        <span asp-validation-for="Nom" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CategorieID" class="form-label">Catégorie *</label>
                        <select asp-for="CategorieID" asp-items="ViewBag.Categories" class="form-control">
                            <option value="">-- Choisir une catégorie --</option>
                        </select>
                        <span asp-validation-for="CategorieID" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="MarqueID" class="form-label">Marque *</label>
                        <select asp-for="MarqueID" asp-items="ViewBag.Marques" class="form-control">
                            <option value="">-- Choisir une marque --</option>
                        </select>
                        <span asp-validation-for="MarqueID" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Prix" class="form-label">Prix (DT) *</label>
                        <input asp-for="Prix" class="form-control" type="number" step="0.01" min="0" />
                        <span asp-validation-for="Prix" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Image du produit</label>

                        @if (!string.IsNullOrEmpty(Model.Image))
                        {
                            <div id="currentImageBlock" class="mb-2">
                                <p class="small text-muted mb-1">Image actuelle :</p>
                                <img id="currentImg" src="@Model.Image" alt="@Model.Nom"
                                     style="height:120px;border-radius:8px;object-fit:contain;border:1px solid var(--border);padding:4px;" />
                                <br />
                                <button type="button" class="btn btn-sm btn-outline-danger mt-1"
                                        onclick="removeCurrentImage()">
                                    ✕ Supprimer l'image
                                </button>
                            </div>
                        }

                        <div class="image-picker-zone" id="pickerZone" onclick="document.getElementById('imageFile').click()">
                            <div id="pickerPlaceholder">
                                <div style="font-size:36px;">🖼️</div>
                                <div style="font-weight:600;color:var(--text-primary);">
                                    @(string.IsNullOrEmpty(Model.Image) ? "Choisir une image" : "Changer l'image")
                                </div>
                                <div style="font-size:12px;color:var(--text-muted);">JPG, PNG, WEBP — max 5 Mo</div>
                            </div>
                            <img id="imagePreview" src="#" alt="Aperçu"
                                 style="display:none;max-height:160px;border-radius:8px;object-fit:contain;" />
                        </div>
                        <input type="file" id="imageFile" name="imageFile"
                               accept=".jpg,.jpeg,.png,.webp,.gif" class="d-none" />
                        <button type="button" id="removeNewBtn"
                                class="btn btn-sm btn-outline-danger mt-2"
                                style="display:none;" onclick="clearNewImage()">
                            ✕ Annuler le changement
                        </button>
                    </div>

                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-warning">💾 Enregistrer</button>
                    <a asp-action="Index" class="btn btn-secondary">Annuler</a>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .image-picker-zone {
        border: 2px dashed var(--border);
        border-radius: var(--radius-md, 10px);
        padding: 24px;
        text-align: center;
        cursor: pointer;
        transition: border-color .2s, background .2s;
        background: var(--blue-ghost, #eaf3fc);
        min-height: 110px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .image-picker-zone:hover {
            border-color: var(--blue-main, #1a6fc4);
            background: #dff0fb;
        }

        .image-picker-zone.has-image {
            border-color: var(--blue-main);
            background: #fff;
            padding: 12px;
        }
</style>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        const fileInput    = document.getElementById('imageFile');
        const preview      = document.getElementById('imagePreview');
        const placeholder  = document.getElementById('pickerPlaceholder');
        const removeNewBtn = document.getElementById('removeNewBtn');
        const zone         = document.getElementById('pickerZone');
        const removeInput  = document.getElementById('removeImageInput');

        fileInput.addEventListener('change', function () {
            const file = this.files[0];
            if (!file) return;
            if (file.size > 5 * 1024 * 1024) { alert('Image trop grande (max 5 Mo)'); this.value=''; return; }
            const reader = new FileReader();
            reader.onload = e => {
                preview.src = e.target.result;
                preview.style.display = 'block';
                placeholder.style.display = 'none';
                removeNewBtn.style.display = 'inline-block';
                zone.classList.add('has-image');
                removeInput.value = 'false';
            };
            reader.readAsDataURL(file);
        });

        function clearNewImage() {
            fileInput.value = '';
            preview.src = '#';
            preview.style.display = 'none';
            placeholder.style.display = 'block';
            removeNewBtn.style.display = 'none';
            zone.classList.remove('has-image');
        }

        function removeCurrentImage() {
            document.getElementById('currentImageBlock').style.display = 'none';
            removeInput.value = 'true';
        }

        // Drag & drop
        zone.addEventListener('dragover', e => { e.preventDefault(); zone.style.borderColor='var(--blue-main)'; });
        zone.addEventListener('dragleave', () => { zone.style.borderColor=''; });
        zone.addEventListener('drop', e => {
            e.preventDefault();
            zone.style.borderColor='';
            const file = e.dataTransfer.files[0];
            if (file && file.type.startsWith('image/')) {
                const dt = new DataTransfer(); dt.items.add(file);
                fileInput.files = dt.files;
                fileInput.dispatchEvent(new Event('change'));
            }
        });
    </script>
}
