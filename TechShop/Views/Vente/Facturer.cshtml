@model TechShop.Models.ViewModels.FacturerVM

@{
    ViewData["Title"] = "Facturer la vente";
    var vente = ViewBag.Vente as TechShop.Models.Vente;
}

<div class="row justify-content-center">
    <div class="col-lg-9">

        <div class="d-flex align-items-center gap-3 mb-4">
            <h2 class="mb-0">🧾 Facturer la vente <code>#@Model.VenteID</code></h2>
            <a asp-action="Index" class="btn btn-secondary ms-auto">Retour</a>
        </div>

        @if (vente != null)
        {
            <div class="card p-3 mb-4">
                <h5 class="mb-3">🛒 Récapitulatif</h5>
                <table class="table table-bordered table-sm align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Produit</th>
                            <th class="text-center">Qté</th>
                            <th class="text-end">Prix unit.</th>
                            <th class="text-end">Sous-total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in vente.Lignes)
                        {
                            <tr>
                                <td>@l.Produit?.Nom <small class="text-muted">(@l.Produit?.Reference)</small></td>
                                <td class="text-center">@l.Quantite</td>
                                <td class="text-end">@l.PrixUnitaire.ToString("N3") DT</td>
                                <td class="text-end">@l.SousTotal.ToString("N3") DT</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        @{
                            decimal ttcArticles = vente.Lignes.Sum(l => l.SousTotal);
                            decimal ht = Math.Round(ttcArticles / (1 + TechShop.Models.Facture.TauxTVA), 3);
                            decimal tva = ttcArticles - ht;
                            decimal totalFinal = ttcArticles + TechShop.Models.Facture.MontantTimbre;
                        }
                        <tr class="table-light">
                            <td colspan="3" class="text-end text-muted">Total TTC (Articles)</td>
                            <td class="text-end">@ttcArticles.ToString("N3") DT</td>
                        </tr>
                        <tr class="table-light small text-muted">
                            <td colspan="3" class="text-end">Dont Montant HT</td>
                            <td class="text-end">@ht.ToString("N3") DT</td>
                        </tr>
                        <tr class="table-light small text-muted">
                            <td colspan="3" class="text-end">Dont TVA (19 %)</td>
                            <td class="text-end">@tva.ToString("N3") DT</td>
                        </tr>
                        <tr class="table-light small text-muted">
                            <td colspan="3" class="text-end">Timbre fiscal</td>
                            <td class="text-end">@TechShop.Models.Facture.MontantTimbre.ToString("N3") DT</td>
                        </tr>
                        <tr class="table-success fw-bold">
                            <td colspan="3" class="text-end">NET À PAYER (TTC)</td>
                            <td class="text-end text-success">@totalFinal.ToString("N3") DT</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }

        <div class="card p-4">
            <h5 class="mb-3">👤 Informations client</h5>
            <form asp-action="Facturer" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="VenteID" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Type de client *</label>
                    <div class="d-flex gap-4">
                        <div class="form-check">
                            <input class="form-check-input" type="radio"
                                   asp-for="TypeClient"
                                   id="typePhysique"
                                   value="Physique"
                                   onchange="toggleClientType()"
                                   checked />
                            <label class="form-check-label" for="typePhysique">
                                👤 Personne physique
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio"
                                   asp-for="TypeClient"
                                   id="typeMorale"
                                   value="Morale"
                                   onchange="toggleClientType()" />
                            <label class="form-check-label" for="typeMorale">
                                🏢 Personne morale (société)
                            </label>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="NomClient" id="lblNomClient" class="form-label">Nom & Prénom *</label>
                        <input asp-for="NomClient" class="form-control" placeholder="ex: Ahmed Ben Ali" />
                        <span asp-validation-for="NomClient" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6" id="mfBlock" style="display:none;">
                        <label asp-for="MatriculeFiscal" class="form-label">Matricule fiscal *</label>
                        <input asp-for="MatriculeFiscal" class="form-control" placeholder="ex: 0000000/A/M/000" />
                        <span asp-validation-for="MatriculeFiscal" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Adresse" class="form-label">Adresse</label>
                        <input asp-for="Adresse" class="form-control" placeholder="ex: 12 Rue de la Liberté, Tunis" />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Telephone" class="form-label">Téléphone</label>
                        <input asp-for="Telephone" class="form-control" placeholder="ex: +216 98 000 000" />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="ex: client@mail.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-success">🧾 Générer la facture</button>
                    <a asp-action="Index" class="btn btn-secondary">Annuler</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        function toggleClientType() {
            const isMorale = document.getElementById('typeMorale').checked;
            document.getElementById('mfBlock').style.display = isMorale ? '' : 'none';
            document.getElementById('lblNomClient').textContent = isMorale ? 'Raison sociale *' : 'Nom & Prénom *';
        }
        toggleClientType();
    </script>
}
