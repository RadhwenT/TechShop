@model List<TechShop.Models.Vente>

@{
    ViewData["Title"] = "Ventes";
    var annees = ViewBag.Annees as List<int> ?? new List<int>();
    int? selAnnee = ViewBag.Annee;
    int? selMois = ViewBag.Mois;
    int? selJour = ViewBag.Jour;
    TechShop.Models.VenteStatut? selStatut = ViewBag.Statut;
    string? search = ViewBag.Search;

    var moisNoms = new[] { "", "Janvier","Février","Mars","Avril","Mai","Juin",
                               "Juillet","Août","Septembre","Octobre","Novembre","Décembre" };
}

<div class="d-flex align-items-center gap-3 mb-4">
    <h2 class="mb-0">Liste des Ventes</h2>
</div>

<form method="get" asp-action="Index" id="filterForm">
    <div class="card p-3 mb-3">
        <div class="row g-2 align-items-end">


            <div class="col-md-3 col-xl">
                <label class="form-label small fw-bold mb-1">🔍 N° Client /facture / Vente</label>
                <input type="text" name="search" class="form-control form-control-sm text-center"
                       value="@search"
                       placeholder="ex: F-2026-001 ou Ahmed" />
            </div>

            <div class="col-md-auto">
                <label class="form-label small fw-bold mb-1">📅 Année</label>
                <select name="annee" class="form-control form-control-sm text-center" onchange="this.form.submit()">
                    <option value="">— Toutes —</option>
                    @foreach (var a in annees)
                    {
                        <option value="@a" selected="@(selAnnee == a)">@a</option>
                    }
                </select>
            </div>

            <div class="col-md-auto">
                <label class="form-label small fw-bold mb-1">📅 Mois</label>
                <select name="mois" class="form-control form-control-sm text-center" onchange="this.form.submit()">
                    <option value="">— Tous —</option>
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(selMois == m)">@moisNoms[m]</option>
                    }
                </select>
            </div>

            <div class="col-md-auto">
                <label class="form-label small fw-bold mb-1">📅 Jour</label>
                <select name="jour" class="form-control form-control-sm text-center" onchange="this.form.submit()">
                    <option value="">— Tous —</option>
                    @for (int j = 1; j <= 31; j++)
                    {
                        <option value="@j" selected="@(selJour == j)">@j</option>
                    }
                </select>
            </div>

            <div class="col-md-auto">
                <label class="form-label small fw-bold mb-1">🏷️ État Livraison</label>
                <select name="statut" class="form-control form-control-sm text-center" onchange="this.form.submit()">
                    <option value="">— Tous —</option>
                    @foreach (var s in Enum.GetValues(typeof(TechShop.Models.VenteStatut)).Cast<TechShop.Models.VenteStatut>())
                    {
                        <option value="@s" selected="@(selStatut == s)">@s</option>
                    }
                </select>
            </div>

            <div class="col-md-auto">
                <label class="form-label small fw-bold mb-1">🧾 Facturation</label>
                <select name="isFacturee" class="form-control form-control-sm text-center" onchange="this.form.submit()">
                    <option value="">— Toutes —</option>
                    <option value="true" selected="@(ViewBag.IsFacturee == true)">Facturées</option>
                    <option value="false" selected="@(ViewBag.IsFacturee == false)">Non facturées</option>
                </select>
            </div>

            <div class="col-md-auto ms-auto d-flex gap-2">
                <a asp-action="Index" class="btn btn-secondary btn-sm text-nowrap" title="Effacer les filtres"><i class="ti ti-refresh"></i></a>
                <a asp-action="Create" class="btn btn-success btn-sm text-nowrap">+ Nouvelle</a>
            </div>
        </div>

        @if (selAnnee.HasValue || selMois.HasValue || selJour.HasValue || selStatut.HasValue || ViewBag.IsFacturee != null || !string.IsNullOrWhiteSpace(search))
        {
            <div class="mt-2">
                <small class="text-muted">
                    Filtres actifs :
                    @if (!string.IsNullOrWhiteSpace(search)) { <span class="badge bg-secondary me-1">Recherche : @search</span> }
                    @if (selStatut.HasValue) { <span class="badge bg-primary me-1">État : @selStatut</span> }
                    @if (ViewBag.IsFacturee != null) { <span class="badge @(ViewBag.IsFacturee == true ? "bg-success" : "bg-warning text-dark") me-1">Facturation : @(ViewBag.IsFacturee == true ? "Facturée" : "Non facturée")</span> }
                    @if (selAnnee.HasValue) { <span class="badge bg-primary me-1">Année : @selAnnee</span> }
                    @if (selMois.HasValue) { <span class="badge bg-primary me-1">Mois : @moisNoms[selMois.Value]</span> }
                    @if (selJour.HasValue) { <span class="badge bg-primary me-1">Jour : @selJour</span> }
                    — @Model.Count résultat(s)
                </small>
            </div>
        }
    </div>
</form>

<div class="table-responsive">
<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>N° Vente</th>
            <th>Date</th>
            <th>Produits</th>
            <th>Client</th>
            <th>Montant HT</th>
            <th>Facture</th>
            <th>État Livraison</th>
            <th style="width:260px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="8" class="text-center text-danger">Aucune vente trouvée</td>
            </tr>
        }
        else
        {
            @foreach (var v in Model)
            {
                <tr>
                    <td><code>#@v.VenteID</code></td>
                    <td>@v.DateVente.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@v.Lignes.Count ligne(s)</td>
                    <td>
                        @if (v.Facture != null)
                        {
                            <span>@v.Facture.NomClient</span>
                        }
                        else
                        {
                            <span class="text-muted small">Non renseigné</span>
                        }
                    </td>
                    <td>@v.MontantHT.ToString("N3") DT</td>
                    <td>
                        @if (v.Facture != null)
                        {
                            <span class="badge bg-success mb-1">🟢 Facturée</span><br />
                            <code>@v.Facture.NumeroFacture</code>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">🟡 Non facturée</span>
                        }
                    </td>
                    <td>
                        @{
                            string badgeClass = v.Statut switch
                            {
                                TechShop.Models.VenteStatut.Validee  => "bg-info text-white",
                                TechShop.Models.VenteStatut.EnExpedition => "bg-primary",
                                TechShop.Models.VenteStatut.Livree => "bg-success",
                                TechShop.Models.VenteStatut.Annulee  => "bg-danger",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @badgeClass">@v.Statut</span>
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            <a asp-action="Details" asp-route-id="@v.VenteID"
                               class="btn btn-primary btn-sm" style="width:76px;">Détails</a>

                            @if (v.Facture == null)
                            {
                                <a asp-action="Facturer" asp-route-id="@v.VenteID"
                                   class="btn btn-success btn-sm" style="width:76px;">Facturer</a>
                            }
                            else
                            {
                                <a asp-action="AfficherFacture" asp-route-id="@v.Facture.FactureID"
                                   class="btn btn-info btn-sm" style="width:76px;">Facture</a>
                            }
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
</div>

@section Scripts {
    <script>
        let debounceTimer;
        document.querySelector('input[name="search"]').addEventListener('input', function () {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => this.form.submit(), 1200);
        });
    </script>
}
