@model TechShop.Models.Utilisateur

@{
    ViewData["Title"] = $"Client - {Model.Nom}";
    var commandes = ViewBag.Commandes as List<TechShop.Models.Vente> ?? new List<TechShop.Models.Vente>();
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-secondary">Retour</a>
    <h2 class="fw-bold m-0">Profil Client</h2>
    <div class="ms-auto">
        @if (Model.IsBlocked)
        {
            <span class="badge bg-danger px-3 py-2 fs-6">Bloqué</span>
        }
        else
        {
            <span class="badge bg-success px-3 py-2 fs-6">Actif</span>
        }
    </div>
</div>

<div class="row">
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-body p-4 text-center">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 80px; height: 80px;">
                    <span class="fs-1 fw-bold">@Model.Nom.Substring(0, 1).ToUpper()</span>
                </div>
                <h4 class="fw-bold mb-1">@Model.Nom</h4>
                <p class="text-muted mb-4">@Model.Email</p>
                
                <hr />
                
                <div class="text-start">
                    <div class="mb-3">
                        <label class="small text-muted text-uppercase fw-bold">Téléphone</label>
                        <div class="fw-bold">@(Model.Telephone ?? "Non renseigné")</div>
                    </div>
                    <div class="mb-3">
                        <label class="small text-muted text-uppercase fw-bold">Adresse</label>
                        <div class="fw-bold">@(Model.Adresse ?? "Non renseignée")</div>
                    </div>
                </div>
                
                <hr />
                
                <form asp-action="ToggleBlock" asp-route-id="@Model.Id" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn @(Model.IsBlocked ? "btn-success" : "btn-danger") w-100">
                        <i class="ti @(Model.IsBlocked ? "ti-lock-open" : "ti-lock") me-2"></i>
                        @(Model.IsBlocked ? "Débloquer le compte" : "Bloquer le compte")
                    </button>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="ti ti-history me-2"></i> Dernières commandes (En ligne)</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">N° Commande</th>
                                <th>Date</th>
                                <th>Montant</th>
                                <th>Statut</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!commandes.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">Aucune commande passée.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var cmd in commandes)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold">#@cmd.VenteID</td>
                                        <td>@cmd.DateVente.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="fw-bold text-primary">@cmd.MontantHT.ToString("N2") DT</td>
                                        <td>
                                            @{
                                                string sClass = cmd.Statut switch {
                                                    TechShop.Models.VenteStatut.EnAttente => "bg-warning text-dark",
                                                    TechShop.Models.VenteStatut.Validee => "bg-info text-white",
                                                    TechShop.Models.VenteStatut.EnExpedition => "bg-primary",
                                                    TechShop.Models.VenteStatut.Livree => "bg-success",
                                                    TechShop.Models.VenteStatut.Annulee => "bg-danger",
                                                    _ => "bg-secondary"
                                                };
                                            }
                                            <span class="badge @sClass">@cmd.Statut</span>
                                        </td>
                                        <td class="text-end pe-4">
                                            <a asp-controller="Commande" asp-action="Details" asp-route-id="@cmd.VenteID" class="btn btn-sm btn-outline-primary">Détails</a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
