@model IEnumerable<TechShop.Models.Utilisateur>

@{
    ViewData["Title"] = "Gestion des Clients";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold m-0"><i class="ti ti-users me-2"></i> Gestion des Clients</h2>
</div>

<div class="card shadow-sm border-0 rounded-3 mb-4">
    <div class="card-body p-4">
        <form method="get" class="mb-4">
            <div class="input-group" style="max-width: 400px;">
                <input type="text" name="search" class="form-control" placeholder="Rechercher un client..." value="@ViewBag.Search">
                <button class="btn btn-primary" type="submit"><i class="ti ti-search"></i></button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Client</th>
                        <th>Email</th>
                        <th>Téléphone</th>
                        <th>Adresse</th>
                        <th class="text-center">Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Aucun client trouvé.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var client in Model)
                        {
                            <tr class="@(client.IsBlocked ? "table-light opacity-75" : "")">
                                <td>
                                    <div class="fw-bold">@client.Nom</div>
                                </td>
                                <td>@client.Email</td>
                                <td>@(client.Telephone ?? "—")</td>
                                <td class="small">@(client.Adresse ?? "—")</td>
                                <td class="text-center">
                                    @if (client.IsBlocked)
                                    {
                                        <span class="badge bg-danger"><i class="ti ti-ban me-1"></i> Bloqué</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success"><i class="ti ti-circle-check me-1"></i> Actif</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@client.Id" class="btn btn-sm btn-outline-primary" title="Voir détails">
                                            <i class="ti ti-eye"></i>
                                        </a>
                                        <form asp-action="ToggleBlock" asp-route-id="@client.Id" method="post" onsubmit="return confirm('Êtes-vous sûr de vouloir @(client.IsBlocked ? "débloquer" : "bloquer") ce client ?');" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(client.IsBlocked ? "btn-success" : "btn-danger")" title="@(client.IsBlocked ? "Débloquer" : "Bloquer")">
                                                <i class="ti @(client.IsBlocked ? "ti-lock-open" : "ti-lock")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
