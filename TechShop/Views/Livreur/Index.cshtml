@model IEnumerable<TechShop.Models.Livreur>

@{
    ViewData["Title"] = "Gestion des Livreurs";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold m-0"><i class="bi bi-truck me-2"></i> Liste des Livreurs</h2>
    <div class="text-end">
        <a asp-action="Create" class="btn btn-success me-1">+ Nouveau</a>
        <a asp-action="Deleted" class="btn btn-secondary">Restaurer</a>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body p-4">
        <form method="get" asp-action="Index" class="mb-4">
            <div class="input-group" style="max-width: 400px;">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control border-start-0" placeholder="Rechercher un livreur..." />
                <button type="submit" class="btn btn-primary">Filtrer</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Nom Complet</th>
                        <th>Téléphone</th>
                        <th width="280" class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-danger">Aucun livreur trouvé.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.Prenom @item.Nom</td>
                                <td><a href="tel:@item.Telephone" class="text-decoration-none"><i class="bi bi-telephone me-1"></i> @item.Telephone</a></td>
                                <td>
                                    <div class="d-flex gap-1 flex-wrap justify-content-center">
                                        <a asp-action="Details" asp-route-id="@item.Id" 
                                           class="btn btn-info btn-sm text-white">Détails</a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" 
                                           class="btn btn-warning btn-sm">Modifier</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" 
                                           class="btn btn-danger btn-sm">Supprimer</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
