@model TechShop.Models.Livreur

@{
    ViewData["Title"] = "Nouveau Livreur";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="d-flex align-items-center mb-4 gap-3">
            <h2 class="fw-bold m-0">Nouveau Livreur</h2>
            <a asp-action="Index" class="btn btn-secondary">Retour</a>
        </div>

        <div class="card shadow-sm border-0 rounded-3 p-4">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Prenom" class="form-label fw-bold">Prénom</label>
                        <input asp-for="Prenom" class="form-control" placeholder="Entrez le prénom" />
                        <span asp-validation-for="Prenom" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Nom" class="form-label fw-bold">Nom</label>
                        <input asp-for="Nom" class="form-control" placeholder="Entrez le nom" />
                        <span asp-validation-for="Nom" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Telephone" class="form-label fw-bold">Téléphone</label>
                        <input asp-for="Telephone" class="form-control" placeholder="Ex: 06 12 34 56 78" />
                        <span asp-validation-for="Telephone" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex gap-2">
                    <button type="submit" class="btn btn-success px-4">💾 Créer le livreur</button>
                    <a asp-action="Index" class="btn btn-secondary px-4">Annuler</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
