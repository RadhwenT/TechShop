@model PROJET.Models.Produit

@{
    ViewData["Title"] = "Détails Produit";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        
        <div class="d-flex align-items-center gap-3 mb-4">
            <h2 class="mb-0">Détails : @Model.Nom</h2>
            <a asp-action="Index" class="btn btn-secondary">Retour</a>
        </div>

        <div class="card p-4">
            <div class="row">
                <div class="col-md-5 text-center mb-4 mb-md-0">
                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <img src="@Model.Image" alt="@Model.Nom" class="img-fluid rounded" style="max-height: 300px; object-fit: contain; border: 1px solid var(--border);" />
                    }
                    else
                    {
                        <div style="height: 250px; background:var(--blue-ghost); border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:64px;">📦</div>
                    }
                </div>
                <div class="col-md-7">
                    <h4 class="mb-3">Informations Générales</h4>
                    
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Référence</dt>
                        <dd class="col-sm-8 fw-bold"><code>@Model.Reference</code></dd>

                        <dt class="col-sm-4 text-muted">Nom</dt>
                        <dd class="col-sm-8">@Model.Nom</dd>

                        <dt class="col-sm-4 text-muted">Catégorie</dt>
                        <dd class="col-sm-8">@Model.Categorie?.Name</dd>

                        <dt class="col-sm-4 text-muted">Marque</dt>
                        <dd class="col-sm-8">@Model.Marque?.Name</dd>

                        <dt class="col-sm-4 text-muted">Prix</dt>
                        <dd class="col-sm-8"><span class="badge bg-primary fs-6">@Model.Prix.ToString("N2") DT</span></dd>

                        <dt class="col-sm-4 text-muted">Stock Actuel</dt>
                        <dd class="col-sm-8">
                            <span class="badge @(Model.Quantite == 0 ? "bg-danger" : Model.Quantite < 5 ? "bg-warning text-dark" : "bg-success")">
                                @Model.Quantite
                            </span>
                        </dd>
                    </dl>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <hr class="my-4" />
                <div class="row">
                    <div class="col-12">
                        <h5 class="mb-2 text-muted">Description</h5>
                        <div class="p-3 bg-light rounded" style="white-space: pre-line;">
                            @Model.Description
                        </div>
                    </div>
                </div>
            }

            <div class="mt-4 d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.ProduitID" class="btn btn-warning">Modifier</a>
                <a asp-action="Stock" asp-route-id="@Model.ProduitID" class="btn btn-primary">Gérer le Stock</a>
            </div>
        </div>
    </div>
</div>
