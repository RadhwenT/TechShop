@model List<PROJET.Models.Produit>

@{
    ViewData["Title"] = "Produits";
}

<h2 class="mb-4">Liste des Produits</h2>

<form method="get" asp-action="Index" id="filterForm" class="mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-md-4">
            <input type="text"
                   name="search"
                   id="searchInput"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Rechercher par nom ou référence..." />
        </div>
        <div class="col-md-2">
            <select name="categorieId" id="categorieSelect" class="form-select" asp-items="ViewBag.Categories">
                <option value="">Toutes les catégories</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="marqueId" id="marqueSelect" class="form-select" asp-items="ViewBag.Marques">
                <option value="">Toutes les marques</option>
            </select>
        </div>
        <div class="col-md-4 text-end">
            <a asp-action="Create" class="btn btn-success me-1">+ Nouveau</a>
            <a asp-action="Deleted" class="btn btn-secondary">Restaurer</a>
        </div>
    </div>
</form>

<div class="table-responsive">
<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th width="90">Image</th>
            <th>Référence</th>
            <th>Nom</th>
            <th>Catégorie</th>
            <th>Marque</th>
            <th>Prix</th>
            <th>Stock</th>
            <th width="280">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="8" class="text-center text-danger">Aucun produit trouvé</td>
            </tr>
        }
        else
        {
            @foreach (var p in Model)
            {
                <tr>
                    <td class="text-center">
                        @if (!string.IsNullOrEmpty(p.Image))
                        {
                            <img src="@p.Image" alt="@p.Nom"
                                 style="width:64px;height:64px;object-fit:cover;border-radius:8px;border:1px solid var(--border);" />
                        }
                        else
                        {
                            <div style="width:64px;height:64px;background:var(--blue-ghost);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:28px;margin:auto;">📦</div>
                        }
                    </td>
                    <td><code>@p.Reference</code></td>
                    <td>@p.Nom</td>
                    <td>@p.Categorie?.Name</td>
                    <td>@p.Marque?.Name</td>
                    <td>@p.Prix.ToString("N2") DT</td>
                    <td>
                        <span class="badge @(p.Quantite == 0 ? "bg-danger" : p.Quantite < 5 ? "bg-warning text-dark" : "bg-success")">
                            @p.Quantite
                        </span>
                    </td>
                    <td>
                        <div class="d-flex gap-1 flex-wrap justify-content-center">
                            <a asp-action="Details" asp-route-id="@p.ProduitID"
                               class="btn btn-info btn-sm text-white">Détails</a>
                            <a asp-action="Stock" asp-route-id="@p.ProduitID"
                               class="btn btn-primary btn-sm">Stock</a>
                            <a asp-action="Edit" asp-route-id="@p.ProduitID"
                               class="btn btn-warning btn-sm">Modifier</a>
                            <a asp-action="Delete" asp-route-id="@p.ProduitID"
                               class="btn btn-danger btn-sm">Supprimer</a>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
</div>

@section Scripts {
    <script>
        let debounceTimer;
        const form = document.getElementById('filterForm');
        
        document.getElementById('searchInput').addEventListener('input', function () {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => {
                form.submit();
            }, 1000);
        });

        document.getElementById('categorieSelect').addEventListener('change', function() {
            form.submit();
        });

        document.getElementById('marqueSelect').addEventListener('change', function() {
            form.submit();
        });
    </script>
}
