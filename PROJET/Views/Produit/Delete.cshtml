@model PROJET.Models.Produit

@{
    ViewData["Title"] = "Supprimer Produit";
}

<div class="row justify-content-center">
    <div class="col-lg-6">

        <div class="card p-4 text-center" style="border-color:#f5c6cb;">
            <div style="font-size:56px;">⚠️</div>
            <h3 class="mt-2 mb-1">Confirmer la suppression</h3>
            <p class="text-muted mb-3">Le produit sera archivé (restaurable).</p>

            @if (!string.IsNullOrEmpty(Model.Image))
            {
                <img src="@Model.Image" alt="@Model.Nom"
                     style="height:100px;border-radius:8px;object-fit:contain;margin-bottom:12px;" />
            }

            <table class="table table-bordered text-start mt-2">
                <tr><th>Référence</th><td><code>@Model.Reference</code></td></tr>
                <tr><th>Nom</th><td>@Model.Nom</td></tr>
                <tr><th>Catégorie</th><td>@Model.Categorie?.Name</td></tr>
                <tr><th>Marque</th><td>@Model.Marque?.Name</td></tr>
                <tr><th>Prix</th><td>@Model.Prix.ToString("N2") DT</td></tr>
                <tr><th>Stock</th><td>@Model.Quantite unité(s)</td></tr>
            </table>

            <div class="d-flex justify-content-center gap-3 mt-3">
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.ProduitID" />
                    <button type="submit" class="btn btn-danger">🗑 Oui, supprimer</button>
                </form>
                <a asp-action="Index" class="btn btn-secondary">Annuler</a>
            </div>
        </div>

    </div>
</div>
