@model PROJET.Models.ViewModels.VenteCreateVM

@{
    ViewData["Title"] = "Nouvelle Vente";
    var produits = ViewBag.Produits as List<PROJET.Models.Produit> ?? new();
}

<div class="row justify-content-center">
    <div class="col-lg-10">

        <div class="d-flex align-items-center gap-3 mb-4">
            <h2 class="mb-0">Nouvelle Vente</h2>
            <a asp-action="Index" class="btn btn-secondary">Retour</a>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@err.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <div class="card p-4">
            <form asp-action="Create" method="post" id="venteForm">
                @Html.AntiForgeryToken()

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">🛒 Lignes de vente</h5>
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="ajouterLigne()">
                        + Ajouter un produit
                    </button>
                </div>

                <table class="table table-bordered align-middle" id="lignesTable">
                    <thead class="table-dark">
                        <tr>
                            <th>Produit</th>
                            <th width="120">Qté disponible</th>
                            <th width="130">Prix unitaire</th>
                            <th width="130">Quantité</th>
                            <th width="130">Sous-total</th>
                            <th width="50"></th>
                        </tr>
                    </thead>
                    <tbody id="lignesBody">
                        <!-- Lignes ajoutées dynamiquement -->
                    </tbody>
                    <tfoot>
                        <tr class="table-light fw-bold">
                            <td colspan="4" class="text-end">Total HT :</td>
                            <td id="totalHT" class="text-primary">0,000 DT</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>

                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-success">💾 Confirmer la vente</button>
                    <a asp-action="Index" class="btn btn-secondary">Annuler</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Données produits injectées depuis le serveur
    const produitsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        produits.Select(p => new {
            id = p.ProduitID,
            nom = p.Nom,
            reference = p.Reference,
            prix = p.Prix,
            stock = p.Quantite
        })
    ));

    let ligneIndex = 0;

    function ajouterLigne() {
        const tbody = document.getElementById('lignesBody');
        const idx = ligneIndex++;

        const options = produitsData.map(p =>
            `<option value="${p.id}" data-prix="${p.prix}" data-stock="${p.stock}">${p.reference} – ${p.nom} (${p.stock} en stock)</option>`
        ).join('');

        const row = document.createElement('tr');
        row.dataset.idx = idx;
        row.innerHTML = `
            <td>
                <select name="Lignes[${idx}].ProduitID" class="form-control produit-select" onchange="onProduitChange(this, ${idx})" required>
                    <option value="">-- Choisir un produit --</option>
                    ${options}
                </select>
            </td>
            <td><span id="stock_${idx}" class="badge bg-secondary">—</span></td>
            <td><span id="prix_${idx}" class="text-muted">—</span></td>
            <td>
                <input type="number" name="Lignes[${idx}].Quantite"
                       class="form-control qte-input" id="qte_${idx}"
                       min="1" value="1" required onchange="recalcul()" oninput="recalcul()" />
            </td>
            <td><span id="sous_${idx}">—</span></td>
            <td>
                <button type="button" class="btn btn-danger btn-sm" onclick="supprimerLigne(this)">✕</button>
            </td>`;

        tbody.appendChild(row);
        recalcul();
    }

    function onProduitChange(sel, idx) {
        const opt = sel.options[sel.selectedIndex];
        const prix = parseFloat(opt.dataset.prix) || 0;
        const stock = parseInt(opt.dataset.stock) || 0;

        document.getElementById(`prix_${idx}`).textContent = prix.toFixed(3) + ' DT';

        const stockBadge = document.getElementById(`stock_${idx}`);
        stockBadge.textContent = stock;
        stockBadge.className = 'badge ' + (stock === 0 ? 'bg-danger' : stock < 5 ? 'bg-warning text-dark' : 'bg-success');

        const qteInput = document.getElementById(`qte_${idx}`);
        qteInput.max = stock;
        if (parseInt(qteInput.value) > stock) qteInput.value = stock;

        recalcul();
    }

    function recalcul() {
        const rows = document.querySelectorAll('#lignesBody tr');
        let total = 0;

        rows.forEach(row => {
            const idx = row.dataset.idx;
            const sel = row.querySelector('.produit-select');
            const qteInput = row.querySelector('.qte-input');

            if (!sel || !qteInput) return;
            const opt = sel.options[sel.selectedIndex];
            const prix = parseFloat(opt?.dataset.prix) || 0;
            const qte = parseInt(qteInput.value) || 0;
            const sous = prix * qte;

            const sousSpan = document.getElementById(`sous_${idx}`);
            if (sousSpan) sousSpan.textContent = sous.toFixed(3) + ' DT';
            total += sous;
        });

        document.getElementById('totalHT').textContent = total.toFixed(3) + ' DT';
    }

    function supprimerLigne(btn) {
        btn.closest('tr').remove();
        recalcul();
    }

    // Démarrer avec une ligne
    ajouterLigne();
</script>
}
